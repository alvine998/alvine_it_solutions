# MongoDB Atlas connection string
# Get this from: https://cloud.mongodb.com → Database → Connect → Connect your application
# Replace <username>, <password>, and <cluster> with your actual values
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alvine_it_solution?retryWrites=true&w=majority

# VPS 9router — fallback when RouterModel.base_url is empty
ROUTER_CUSTOMER_URL=https://router.alvineitsolutions.com/v1

# Telegram — admin notifications on payment submission (also configurable via Admin > Settings)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server port
PORT=4005