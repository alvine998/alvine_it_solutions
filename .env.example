# MongoDB Atlas connection string
# Replace with your actual connection string from MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/alvine_it_solution?retryWrites=true&w=majority

# VPS 9router — router_customer backend (single source: RouterModel.base_url in DB)
# Server uses ROUTER_CUSTOMER_URL as fallback when base_url empty; client uses VITE_ROUTER_CUSTOMER_URL
ROUTER_CUSTOMER_URL=https://router.alvineitsolutions.com/v1
VITE_ROUTER_CUSTOMER_URL=https://router.alvineitsolutions.com

# Cloudflare R2 Object Storage — QRIS images are stored here and served via the
# R2 public URL (R2.dev.dev subdomain or your custom domain).
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL used to serve objects, e.g. https://cdn.alvineitsolutions.com
R2_PUBLIC_URL=